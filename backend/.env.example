PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB - leave MONGODB_URI empty to run on in-memory demo data.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=maw

# MQTT, data node MAW (mobile + website). MQTT_OFFLINE_TIMEOUT=0: status perangkat hanya dari MQTTX, tidak otomatis offline.
# Field hardware publishes to:  maw/hardware/<crossing_id>/<component_id>
MQTT_URL=wss://broker.emqx.io:8084/mqtt
MQTT_TOPIC_ROOT=maw/hardware
MQTT_CLIENT_ID=maw-mqtt
MQTT_OFFLINE_TIMEOUT=0

# MAW decision engine (mobile/DESIGN.md bagian 3 & 8). Kalibrasi di lapangan.
# Topik data Sensor Node. Di broker publik, pakai prefiks unik tim (DESIGN.md 9).
MAW_NODE_TOPIC=mqx/node/data
# MAW_T_TUTUP harus sama dengan threshold firmware ESP32.
MAW_T_TUTUP=0.60
MAW_T_SIAGA=0.40
MAW_HOLD_BUKA_S=20
MAW_STALE_MAX_S=15
MAW_HEARTBEAT_S=5
MAW_SCORE_TOL=0.02
# Bobot: getaran/beban/magnet/suara (total 1,00)
MAW_W_GETARAN=0.35
MAW_W_BEBAN=0.30
MAW_W_MAGNET=0.20
MAW_W_SUARA=0.15
# Pemetaan node -> perlintasan (JSON). Kosong = pakai src/config/nodeMap.json
MAW_NODE_MAP=
# Koneksi MQTT khusus website (status perangkat di topik MQTT_TOPIC_ROOT/#), terpisah dari data node.
HARDWARE_MQTT_URL=mqtt://broker.emqx.io:1883
# Backend menambah akhiran acak (mis. Hardware-MAW-a3f9c1) agar tidak bentrok dengan sesi MQTTX.
HARDWARE_MQTT_CLIENT_ID=Hardware-MAW
# Batas waktu petugas mengonfirmasi palang ditutup setelah TUTUP (detik).
MAW_CLOSE_DEADLINE_S=20
