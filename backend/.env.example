# Hosting providers set PORT themselves: do not set it in production.
PORT=5000
# Set to production when deployed (turns simulation off and hides error details).
NODE_ENV=development
# Allowed browser origins (CORS): one URL or a comma separated list. A * matches one
# subdomain, e.g. https://*.vercel.app for Vercel preview deployments.
# Production example: FRONTEND_URL=https://maw.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:5173
# Production only: allow the Simulation Center (supervisors only). Leave unset on a public server.
# MAW_ENABLE_SIM=true

# MongoDB. Leave MONGODB_URI empty to run on in-memory demo data.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Atlas rejects connections from IPs that are not listed under Network Access.
MONGODB_URI=
MONGODB_DB=maw

# MQTT for sensor node data (barrier decisions, mobile app and website).
# Empty MQTT_URL disables MQTT. On a public broker use a unique topic prefix.
MQTT_URL=wss://broker.emqx.io:8084/mqtt
MQTT_CLIENT_ID=maw-mqtt
MAW_NODE_TOPIC=mqx/node/data

# MQTT for device status (website Device Health), separate from node data.
# Topic: <MQTT_TOPIC_ROOT>/<crossing_id>/<device>, payload {"status":"connected"|"disconnected"}
# Empty HARDWARE_MQTT_URL reuses the connection above.
HARDWARE_MQTT_URL=mqtt://broker.emqx.io:1883
HARDWARE_MQTT_CLIENT_ID=Hardware-MAW
MQTT_TOPIC_ROOT=maw/hardware
# Seconds of silence before a component is marked offline. 0 = device status comes only from MQTT.
MQTT_OFFLINE_TIMEOUT=0

# Barrier decision engine (mobile/DESIGN.md sections 3 and 8). Calibrate in the field.
# MAW_T_TUTUP must equal the threshold in the ESP32 firmware.
MAW_T_TUTUP=0.60
MAW_T_SIAGA=0.40
MAW_HOLD_BUKA_S=20
MAW_STALE_MAX_S=15
MAW_HEARTBEAT_S=5
MAW_SCORE_TOL=0.02
# Seconds the guard has to confirm the barrier is closed after TUTUP.
MAW_CLOSE_DEADLINE_S=20
# Sensor weights: vibration, load, magnetic, sound (sum to 1.00).
MAW_W_GETARAN=0.35
MAW_W_BEBAN=0.30
MAW_W_MAGNET=0.20
MAW_W_SUARA=0.15
# Node to crossing map as JSON. Empty uses src/config/nodeMap.json.
MAW_NODE_MAP=
