PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB - leave MONGODB_URI empty to run on in-memory demo data.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=maw

# MQTT - hardware health ingest. Leave MQTT_URL empty to disable.
# Field hardware publishes to:  maw/hardware/<crossing_id>/<component_id>
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_TOPIC_ROOT=maw/hardware
MQTT_CLIENT_ID=maw-backend
MQTT_OFFLINE_TIMEOUT=30
