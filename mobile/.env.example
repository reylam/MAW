# Backend API base URL (same backend as frontend VITE_API_URL, backend PORT=5000).
# Emulator Android : http://10.0.2.2:5000/api
# HP fisik (Expo Go): IP LAN komputer yang menjalankan backend, mis. http://192.168.1.10:5000/api
# Web / iOS simulator: http://localhost:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Opsional. Default: diturunkan dari API URL -> ws://<host>:5000/ws
# EXPO_PUBLIC_WS_URL=ws://localhost:5000/ws

# Opsional. Kunci HP ini ke satu perlintasan (id dari backend nodeMap.json).
# Kosong = perlintasan pertama yang dilaporkan backend.
# EXPO_PUBLIC_CROSSING_ID=crossing-01
