# Backend API base URL (backend PORT=5000). Used by every service in src/services.
VITE_API_URL=http://localhost:5000/api

# Optional. WebSocket for the live feed (crossing state, simulation status).
# Default: derived from VITE_API_URL -> ws://<host>:5000/ws
# VITE_WS_URL=ws://localhost:5000/ws

# Notes
# - Variables must start with VITE_ to reach the browser. Never put secrets here
#   (MongoDB URI, MQTT credentials stay in backend/.env).
# - Restart `npm run dev` after changing this file.
# - Opening the dashboard from another device (e.g. a phone on the same Wi-Fi)?
#   Use the laptop LAN IP instead of localhost, e.g. http://192.168.1.24:5000/api,
#   and set FRONTEND_URL in backend/.env to the dashboard address
#   (http://192.168.1.24:5173) so CORS allows it.
